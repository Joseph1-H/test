# ATLAS configuration. setup.sh copies this to .env (owner-only permissions).
# Never commit .env: it can contain API keys.

# ---- Local model (Ollama) ----------------------------------------------------
# qwen2.5-coder:7b (Apache-2.0) fits a 6 GB RTX 4050. Lighter: qwen2.5-coder:1.5b
ATLAS_LOCAL_MODEL=qwen2.5-coder:7b
OLLAMA_HOST_URL=http://localhost:11434
# Context window in tokens. Larger uses more GPU memory; 8192 fits 6 GB with the 7B model.
ATLAS_NUM_CTX=8192
ATLAS_TEMPERATURE=0.2
# Seconds to wait for the model before giving up (per chunk of output).
ATLAS_REQUEST_TIMEOUT=300

# ---- Cloud model (optional, any OpenAI-compatible API) ----------------------------
# Off unless ATLAS_CLOUD_ALLOWED=true, and ATLAS still asks before each session's first cloud use.
ATLAS_CLOUD_ALLOWED=false
ATLAS_CLOUD_BASE_URL=
ATLAS_CLOUD_MODEL=
ATLAS_CLOUD_API_KEY=
# Examples:
#   ATLAS_CLOUD_BASE_URL=https://openrouter.ai/api/v1
#   ATLAS_CLOUD_BASE_URL=http://localhost:8000/v1   (a local vLLM / llama.cpp server: counts as local)

# ---- Misc ------------------------------------------------------------------------------
# ATLAS_WORKSPACE=/data/projects/example   (default: the folder you start atlas in)
# ATLAS_DATA_DIR=~/.local/share/atlas      (logs)
ATLAS_LOG_LEVEL=INFO
